# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วใส่ค่าจริงของคุณ
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=expense_tracker

# Generate a long random secret and keep it private.
SECRET_KEY=replace_with_a_random_secret
# Set 1 on HTTPS production; keep 0 for local HTTP.
COOKIE_SECURE=0

APP_ENV=development
# Required when APP_ENV=production; replace with your HTTPS domain.
PUBLIC_URL=https://expense.example.com

# TiDB / remote MySQL
DB_PORT=3306
# Render: /etc/ssl/certs/ca-certificates.crt
DB_SSL_CA=
